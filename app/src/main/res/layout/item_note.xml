<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="12dp"
    app:cardCornerRadius="15dp"
    app:cardElevation="3dp"
    app:cardUseCompatPadding="true"
    android:layout_margin="5dp"
    >
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:orientation="vertical"
    android:layout_margin="10dp"
    android:padding="5dp"
    >
    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/tvTitleId_Cord"
        android:textSize="16sp"
        android:layout_margin="5dp"
        android:text="اسم الملاحضة"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:ellipsize="end"
        />
    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:text="الوصف"
        android:layout_margin="5dp"
        android:textSize="15sp"
        android:textColor="?attr/colorOnSurface"
        android:id="@+id/tvContentId_cord"
        android:maxLines="2"

        />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/tvDateId_cord"
        android:ellipsize="end"
        android:layout_margin="3dp"
        android:text="التاريخ"
        android:textSize="13sp"
        />


    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="5dp"
        android:padding="2dp"

        >
        <com.google.android.material.button.MaterialButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/btnDeleted_id_cord"

            app:icon="@drawable/delete_"
            app:iconTint="#5a2e34"
            app:backgroundTint="#f1e9f7"
            />

        <com.google.android.material.button.MaterialButton
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:id="@+id/btnEdit_id_cord"
    app:icon="@drawable/_create_"
    app:iconTint="#4b5a76"
    app:backgroundTint="#f1e9f7"


    />
    </LinearLayout>
</LinearLayout>

</com.google.android.material.card.MaterialCardView>
